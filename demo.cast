[30.933077, "o", "\r\n\u001b[?2004l\r"]
[30.93911, "o", "NAME:\r\n"]
[30.939505, "o", "   hexlet-path-size - print size of a file or directory\r\n\r\nUSAGE:\r\n"]
[30.939766, "o", "   hexlet-path-size [global options]\r\n\r\nGLOBAL OPTIONS:\r\n"]
[30.940098, "o", "   --human, -H      human-readable sizes (auto-select unit) (default: false)\r\n   --all, -a        include hidden files and directories (default: false)\r\n   --recursive, -r  recursive size of directories (default: false)\r\n   --help, -h       show help\r\n"]
